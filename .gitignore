```gitignore
# ========================
# ARCHIVOS IGNORADOS
# ========================

# Configuración de IDEs
.idea/
.vscode/

# Backend Node
backend/node_modules/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws

# Flutter/Dart genéricos (para cualquier proyecto Flutter en el repo)
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Web related (Flutter)
lib/generated_plugin_registrant.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio build artifacts (genéricos)
android/app/debug
android/app/profile
android/app/release

# Carpeta específica del proyecto flutter_frontend
flutter_frontend/.dart_tool/
flutter_frontend/.flutter-plugins
flutter_frontend/.flutter-plugins-dependencies
flutter_frontend/.packages
flutter_frontend/.pub-cache/
flutter_frontend/.pub/
flutter_frontend/build/
flutter_frontend/android/app/debug
flutter_frontend/android/app/profile
flutter_frontend/android/app/release